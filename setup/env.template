# PyWiki environment configuration
#
#  Copy this file to .env and adjust values as needed.
#  Keep comments on their own lines: systemd passes anything after the value
#  (including "# ...") through as part of it.
#
# ---------------------------------------------------------------------------

# ── Installation ───────────────────────────────────────────────────────────
DIR_NAME=pywiki
SERVICE_NAME=pywiki
DB_NAME=pywiki


# ── Application ────────────────────────────────────────────────────────────
APP_NAME=PyWiki
# uvicorn port, used by `make dev`/`make start-bg` and by setup/pywiki.service.
# Development: 8000.
# Production behind nginx: 8 followed by the instance IP's last octet,
# zero-padded to 3 digits (e.g. 10.0.0.222 -> 8222, 10.0.0.82 -> 8082).
# nginx proxy_pass in setup/nginx-pywiki.conf must use the same port.
APP_PORT=8000
# Log file name for `make start-bg`, written under /tmp (default: pywiki-<APP_PORT>.log).
# APP_LOG=pywiki.log
# Browser-reachable URL; in production the external https:// URL, never the uvicorn port.
BASE_URL=http://localhost:8000
DEBUG=false
ENVIRONMENT=development


# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL (production default — requires a running PostgreSQL server)
DATABASE_URL=postgresql+asyncpg://pywiki:pywiki@localhost:5432/pywiki

# Pool settings (PostgreSQL only — ignored for SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# SQLite (development / quick start — no external server needed)
# DATABASE_URL=sqlite+aiosqlite:///./pywiki.db


# ── Auth / JWT ─────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30


# ── Storage ────────────────────────────────────────────────────────────────
ATTACHMENT_ROOT=./data/attachments
# 50 MB.  If you raise it, raise client_max_body_size in the nginx config too.
MAX_ATTACHMENT_BYTES=52428800
# File types that may be uploaded, comma- or space-separated (like MediaWiki's
# $wgFileExtensions).  Executable and web content types (html, js, php, exe, ...)
# and macro-enabled Office files (docm, xlsm, pptm, ...) are always refused,
# even if listed here.
ATTACHMENT_EXTENSIONS=png,jpg,jpeg,gif,webp,avif,svg,bmp,pdf,txt,md,csv,docx,xlsx,pptx,odt,ods,odp


# ── Wiki defaults ──────────────────────────────────────────────────────────
DEFAULT_NAMESPACE=Main
SITE_NAME=PyWiki
ADMIN_EMAIL=admin@example.com
ALLOW_REGISTRATION=true


# ── Layout ─────────────────────────────────────────────────────────────────
# Default page width for readers who have not used the width toggle in the header.
#   auto   - 90% of the reader's screen width, never below 1200px
#   full   - fill the browser window
#   <size> - a CSS length such as 1600px, 100rem or 90% (a bare number means px)
LAYOUT_MAX_WIDTH=auto


# ── CORS ───────────────────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:8000","http://localhost:3000"]


